# ── Supabase ────────────────────────────────────────────────
# Supabase 대시보드 → Settings → API Keys 에서 확인
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."   # Publishable key
SUPABASE_SERVICE_ROLE_KEY="eyJ..."                   # JWT Keys → service_role (절대 공개 금지)

# Supabase 대시보드 → Database → Settings → Connection pooling
# Transaction mode (포트 6543) — 앱 런타임용
DATABASE_URL="postgresql://postgres.PROJECT-REF:[password]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session mode (포트 5432) — Prisma 마이그레이션 전용
DIRECT_URL="postgresql://postgres.PROJECT-REF:[password]@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ── 인증 ────────────────────────────────────────────────────
# 랜덤 64자 이상 문자열 — 절대 기본값 사용 금지
JWT_SECRET="change-this-to-a-random-secret-in-production"

# 학생 초기 비밀번호 (미설정 시 math1234 사용)
STUDENT_INITIAL_PASSWORD="math1234"

# ── 앱 ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── AI (학습지 정답 추출) ───────────────────────────────────
# console.anthropic.com → API Keys 에서 발급. 학습지 업로드 → AI 정답 읽기에 사용
ANTHROPIC_API_KEY="sk-ant-..."

# ── 카카오 알림톡 / 문자 (비즈엠) ──────────────────────────
# 아래 4개가 모두 설정되어야 실제 발송이 이루어진다.
# 미설정 시 발송 화면에 "미발송(미연동)"으로 기록되고 학부모에게 전달되지 않는다.
# 사전 절차: 비즈엠 계약 → 카카오 채널 발신프로필 등록 → 알림톡 템플릿 심사 승인 → 발신번호 사전등록
KAKAO_BIZ_USER_ID=""            # 비즈엠 userId (HTTP 헤더 userId로 전송)
KAKAO_SENDER_KEY=""             # 카카오 채널 발신프로필 키 (senderKey / profile)
KAKAO_ALIMTALK_TEMPLATE_ID=""   # 심사 승인된 알림톡 템플릿 코드
KAKAO_SENDER_PHONE=""           # 사전등록된 SMS/LMS 대체 발송 발신번호
# BIZMSG_API_URL="https://api.bizmsg.kr/v2/sender/send"   # 기본값. 다른 엔드포인트 사용 시에만 설정
