generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String   @id @default(cuid())
  name       String
  phone      String   @unique // 11자리 핸드폰번호 = 로그인 아이디
  password   String
  role       Role
  supabaseId String?  @unique // Supabase Auth UUID (auth.users.id)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  teacher Teacher?
  student Student?
}

model Teacher {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 관리자 권한 — 선생님 계정 등록·삭제와 학생 퇴원 처리는 관리자만 할 수 있다
  isAdmin Boolean @default(false)
  /// 수업을 맡는 선생님인가. false 면 학원 전체를 관리만 하는 계정(예: 교육실장)이라
  /// 시간표 화면의 선생님 목록에 나오지 않는다. 이름으로 거르면 사람이 바뀔 때마다
  /// 코드를 고쳐야 해서 계정에 표시를 둔다.
  teachesClasses Boolean @default(true)

  // 문제집 문제유형(구역) 목록 — 선생님이 직접 추가·삭제한다.
  // null이면 TEXTBOOK_SECTION_PRESETS 기본값을 쓴다. JSON: ["A단계","필수유형",...]
  sectionPresetsJson String?

  students    Student[]
  worksheets  Worksheet[]
  textbooks   Textbook[]
  schedules   ClassSchedule[]
  rewardItems RewardItem[]
  rewardRules RewardRule[]
  reportConfig AttendanceNotificationConfig?

  @@index([userId])
  /// 문제은행에서 학습지를 뽑은 기록
  worksheetGenRequests WorksheetGenRequest[]
}

// ── 주간 수업 시간표 ──────────────────────────────────────────────────────────
model ClassSchedule {
  id           String  @id @default(cuid())
  teacherId    String
  teacher      Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  dayOfWeek    Int // 0=월, 1=화, 2=수, 3=목, 4=금, 5=토, 6=일
  startTime    String // "09:00"
  endTime      String // "10:30"
  subject      String // 수업 과목명
  grade        String // 학년 (예: 중1, 고2)

  // 이 수업을 듣는 학생. 예전에는 studentNames 에 이름 문자열 배열로 들고 있었는데
  // 동명이인이면 어느 학생인지 가릴 수 없어 지각 분수를 자동 계산할 수 없었다.
  students     ClassScheduleStudent[]

  // 이관 전 원본. 이름 매칭에 실패한 건을 되짚기 위해 남겨 둔다 — 더 이상 읽거나 쓰지 않는다.
  studentNames String  @default("[]")

  @@index([teacherId, dayOfWeek])
}

/** 수업 ↔ 학생 (다대다) */
model ClassScheduleStudent {
  scheduleId String
  schedule   ClassSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([scheduleId, studentId])
  @@index([studentId])
}

model Student {
  id        String  @id @default(cuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  school      String @default("") // 학교명
  grade       String @default("") // 학년 (예: 중1, 고2)
  parentName  String @default("") // 보호자 이름
  parentPhone String @default("") // 보호자 연락처
  startDate   String @default("") // 수업시작일 (YYYY-MM-DD)
  status      String @default("active") // "active" | "withdrawn"

  // 선택 입력 — 학생 상세 정보 팝업에서 수정한다
  address   String @default("") // 집 주소
  homePhone String @default("") // 집 전화
  birthDate String @default("") // 생년월일 (YYYY-MM-DD)
  email     String @default("") // 학생 이메일
  memo      String @default("") // 특이사항 메모

  // 4자리 출결 번호 (미지정 시 학생 번호 끝 4자리 자동 매칭, 형제자매 번호 충돌 시 커스텀 지정)
  attendancePin String?

  gradeLevel      String?         // '초' | '중' | '고'
  studentAppId    String?         @unique // S29757874
  parentAppId     String?         @unique // P51560034
  studentPhone    String?         // 01054013630
  schoolName      String?         // 수완초
  classStartDate  DateTime?

  // 레벨(Lv.1~9)과 칭호는 평균 정답률에서 계산된다. lib/studentLevel.ts 참고
  currentLevel   Int         @default(1)
  currentMission MissionType @default(concept_learning)

  // 평균 정답률(%) — 채점 기록이 없으면 null (칭호 '수학 입문자').
  // 진행 중 교재·최근 90일 학습지 70% + 끝낸 교재·오래된 학습지 30%
  avgCorrectRate Float?

  comprehension Float @default(0)
  reasoning     Float @default(0)
  calculation   Float @default(0)

  rewardPoints Int @default(0)

  results              MissionResult[]
  distributions        WorksheetDistribution[]
  textbookAssignments  TextbookAssignment[]
  textbookResults      TextbookResult[]
  rewards              StudentReward[]
  pointHistory         PointTransaction[]
  autoRewardLogs       AutoRewardLog[]
  subUnitStats         StudentSubUnitStat[]
  patternStats         StudentPatternStat[]
  dailyLessonReports   DailyLessonReport[]
  attendanceLogs       AttendanceLog[]
  alimtalkLogs         AlimtalkLog[]
  weaknessConfig       StudentWeaknessConfig?
  prescriptiveMissions PrescriptiveMission[]
  reportOverrides      DailyStudentReportOverride[]
  classSchedules       ClassScheduleStudent[]

  @@index([teacherId])
  @@index([attendancePin])
  /// 이 학생을 위해 뽑은 학습지 기록
  worksheetGenRequests WorksheetGenRequest[]
  /// 축별 취약 집계 (취약유형 학습지의 근거)
  weaknesses           StudentWeakness[]
  /// 교재 페이지별 채점 상태
  textbookPageProgress TextbookPageProgress[]
}

// ── 교재 ────────────────────────────────────────────────────────────────────
model Textbook {
  id        String   @id @default(cuid())
  title     String
  grade     String
  publisher String   @default("직접 출제")
  // 하원 리포트가 연산교재와 진도교재를 따로 보고한다 ('진도' | '연산')
  kind      String   @default("진도")
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  problems     TextbookProblem[]
  results      TextbookResult[]
  assignments  TextbookAssignment[]
  answerImages AnswerImage[]

  @@index([teacherId])
  /// 학생별 페이지 채점 상태
  pageProgress TextbookPageProgress[]
}

model TextbookProblem {
  id         String   @id @default(cuid())
  textbookId String
  textbook   Textbook @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  number     Int
  bookPage   Int      @default(0) // 교재 쪽번호 (0 = 미지정)
  majorUnit  String   @default("") // 대단원
  middleUnit String   @default("") // 중단원
  minorUnit  String   @default("") // 소단원
  section    String   @default("") // 문제유형/단계: '필수유형'|'확인 체크'|'대표문제'|'서술형' 등 자유 입력
  subSection String   @default("") // 문제유형의 하위 단계: '유형 1'|'심화'|'(1)' 등 교재별 자유 입력
  type       String   @default("multiple") // "multiple" | "short" | "image"
  answer     String   @default("") // type='image'이면 IMAGE_ANSWER_MARKER

  // ── 교육과정 좌표 ─────────────────────────────────────────────────────────
  // 위의 majorUnit/middleUnit/minorUnit/section 은 "그 교재가 쓰는 말"이라 교재마다
  // 다르다. 문제은행으로 모으려면 전 교재 공통 좌표가 따로 있어야 한다.
  //   subUnitId·patternTypeId — 소단원(581) / 유형(1,305). "어디서 배우는 문제인가"
  //   conceptNodeId           — 개념노드(1,474). "무슨 개념인가". 선수관계 역추적의 출발점
  // 셋 다 Nullable — 분류는 한 번에 끝나지 않고 계속 붙여 나간다.
  subUnitId     String?
  subUnit       MathSubUnit?     @relation(fields: [subUnitId], references: [id], onDelete: SetNull)
  patternTypeId String?
  patternType   MathPatternType? @relation(fields: [patternTypeId], references: [id], onDelete: SetNull)
  conceptNodeId String?
  conceptNode   ConceptNode?     @relation(fields: [conceptNodeId], references: [id], onDelete: SetNull)

  // 공식 난이도 1~5 (packages/shared 의 Difficulty). null = 아직 안 매김
  difficulty    Int?

  @@unique([textbookId, number])
  @@index([textbookId, number])
  // 교재 페이지별 조회 — 정답 입력 화면의 기본 이동 단위
  @@index([textbookId, bookPage, number], map: "TextbookProblem_page_idx")
  // 단원/유형별 조회 — 문제 수가 수천 개여도 필요한 구간만 읽기 위한 인덱스
  @@index([textbookId, majorUnit, middleUnit, minorUnit, section, subSection], map: "TextbookProblem_unit_idx")
  @@index([subUnitId, difficulty])
  @@index([patternTypeId, difficulty])
  @@index([conceptNodeId])
}


/// 학생 × 교재 × **페이지** 채점 상태.
///
/// TextbookResult 는 교재 한 권을 한 행으로 들고 있어 "이 페이지를 다 봤나"를
/// 알 수 없다. 교재는 한 번에 다 풀지 않고 페이지를 나눠 나가므로,
/// 선생님이 오늘 어디까지 채점했는지 페이지 단위로 남아야 한다.
///
/// 정답(TextbookProblem.answer)도 페이지 단위로 입력하고, 채점도 페이지 단위로
/// 한다. 둘의 이동 단위를 맞춰야 화면이 따로 놀지 않는다.
model TextbookPageProgress {
  id         String   @id @default(cuid())
  textbookId String
  textbook   Textbook @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// 교재 쪽번호. TextbookProblem.bookPage 와 같은 값
  bookPage   Int

  /// 'todo'(아직) | 'doing'(진도 체크 — 나가는 중) | 'done'(완료됨)
  status      String   @default("todo")
  /// 이 페이지에서 채점한 문항 수 / 틀린 수
  gradedCount Int      @default(0)
  wrongCount  Int      @default(0)

  gradedAt   DateTime?
  /// 누가 채점했나 — 'student'(앱 제출) | 선생님 이름
  gradedBy   String?
  updatedAt  DateTime @updatedAt

  @@unique([textbookId, studentId, bookPage])
  @@index([studentId, textbookId, bookPage])
  @@index([textbookId, bookPage, status])
}

// 교재 배정 — 학습지의 WorksheetDistribution과 같은 역할.
// 어떤 학생이 어떤 교재를 진행 중인지 저장한다. 채점 결과는 TextbookResult에 따로 쌓인다.
model TextbookAssignment {
  id          String    @id @default(cuid())
  textbookId  String
  textbook    Textbook  @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedAt  DateTime  @default(now())
  // 교재를 끝낸 시점. null이면 아직 진도를 나가는 중이다.
  // 진행 중 교재는 등급 계산에 70%, 끝낸 교재는 30% 반영된다 (lib/studentLevel.ts)
  completedAt DateTime?

  @@unique([textbookId, studentId])
  @@index([studentId])
  @@index([textbookId])
}

model TextbookResult {
  id                String   @id @default(cuid())
  textbookId        String
  textbook          Textbook @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  wrongProblemsJson String   @default("[]")
  gradedBy          String   @default("teacher")
  submittedAt       DateTime @default(now())

  // 학생이 낸 답. 교재는 문제 번호가 1부터 이어지지 않을 수 있어
  // 배열이 아니라 { "12": "3", "13": "x=5" } 형태의 맵으로 담는다
  studentAnswersJson  String @default("{}")
  // 자동 채점이 판정하지 못한 문제 번호 (이미지 정답 등)
  pendingProblemsJson String @default("[]")
  // 학생이 지금까지 답을 낸 문항 수. 정답률의 분모로 쓴다
  submittedCount      Int    @default(0)

  @@unique([textbookId, studentId])
  @@index([studentId])
}


// ── 학습지 생성 ─────────────────────────────────────────────────────────────
//
// 문제은행에서 문항을 골라 학습지를 만든다. 다섯 가지가 있고 고르는 방식만 다르다.
//   TYPE      유형별   — 선생님이 소단원·유형·난이도를 직접 고른다
//   DAILY     일일테스트 — 최근 배운 범위에서 짧게 (5~10문항)
//   UNIT_EXAM 단원평가 — 한 단원을 난이도 골고루 (20~25문항)
//   WRONG     오답유형 — 그 학생이 틀린 문항의 유사문제
//   WEAK      취약유형 — 그 학생의 정답률이 낮은 유형에서
//
// **생성 조건을 남기는 이유** — 같은 학습지를 다시 뽑거나, 왜 이 문제가 나왔는지
// 나중에 따져야 한다. 결과 문항만 저장하면 둘 다 못 한다.

model WorksheetGenRequest {
  id        String   @id @default(cuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  /// 특정 학생을 위해 만든 것이면 그 학생. 반 전체용이면 null
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  /// 'TYPE' | 'DAILY' | 'UNIT_EXAM' | 'WRONG' | 'WEAK'
  kind      String
  title     String
  /// 뽑으려 한 문항 수. 모자라면 실제로는 더 적을 수 있다
  wanted    Int
  /// 실제로 뽑힌 문항 수
  produced  Int      @default(0)

  /// 고른 조건 그대로 (소단원·유형·개념·난이도 범위·기간 등). 형태는
  /// packages/shared 의 WorksheetGenSpec 을 따른다
  specJson  String   @db.Text
  /// 왜 이 문항들이 나왔는지 — 후보 수, 제외된 이유, 부족했던 조건
  traceJson String?  @db.Text

  /// 만들어진 학습지. 생성만 하고 아직 확정하지 않았으면 null
  worksheetId String?  @unique
  worksheet   Worksheet? @relation(fields: [worksheetId], references: [id], onDelete: SetNull)

  items     WorksheetGenItem[]
  createdAt DateTime @default(now())

  @@index([teacherId, createdAt])
  @@index([studentId, kind])
}

/// 생성된 학습지의 문항 한 줄. 순서와 출처를 남긴다
model WorksheetGenItem {
  requestId  String
  request    WorksheetGenRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  questionId String
  question   Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// 학습지에서 몇 번인가 (1부터)
  number     Int
  /// 왜 뽑혔나 — 'match'(조건 일치) | 'similar'(오답 유사문제) | 'weak'(취약유형) | 'fill'(수가 모자라 채움)
  reason     String              @default("match")
  /// 오답유형일 때 어떤 문항 때문에 뽑혔는지
  sourceQuestionId String?

  @@id([requestId, questionId])
  @@index([questionId])
}

/// 학생 × 유형 정답률 — 취약유형을 뽑는 근거.
/// StudentPatternStat 과 다른 점: 저것은 4계층 유형(MathPatternType)만 보고
/// 이것은 개념노드까지 함께 본다. 취약유형 학습지는 둘 다 필요하다.
model StudentWeakness {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// 어느 축의 취약인가 — 'pattern'(유형) | 'concept'(개념) | 'subunit'(소단원)
  axis          String
  /// 그 축의 id
  targetId      String
  /// 최근 집계 기준 정답률 (0~100)
  accuracy      Float
  /// 분모 — 몇 문항을 풀어 나온 값인가. 적으면 신뢰할 수 없다
  attempted     Int
  wrongCount    Int
  /// 마지막으로 계산한 시각
  computedAt    DateTime @default(now())

  @@unique([studentId, axis, targetId])
  @@index([studentId, accuracy])
}

// ── 학습지 ──────────────────────────────────────────────────────────────────
model Worksheet {
  id           String   @id @default(cuid())
  title        String
  category     String // '단원별' | '내신대비'
  step         String // '기초'|'기본'|'발전'|'최상위'|'최다빈출'|'최다오답'|'서술형'|'모의고사'
  examSubType  String? // 모의고사 세부: '실전모의고사'|'기출모의고사'|'직전대비모의고사'
  grade        String // '중1'|'중2' 등
  unit         String   @default("종합")
  problemCount Int
  source       String   @default("manual") // 'mathflat'|'manual'
  answersJson  String? // JSON: ["①","15","2x+3","__img__",...] 문제별 정답 배열
  // "__img__" = 서술형 이미지 정답 → WorksheetAnswerImage에 저장됨
  teacherId    String
  teacher      Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  distributions WorksheetDistribution[]
  answerImages  AnswerImage[]
  /// 이 학습지를 만들어 낸 생성 요청 (문제은행에서 뽑은 경우)
  genRequest    WorksheetGenRequest?

  @@index([teacherId])
  @@index([category, step])
}

// 서술형 정답 이미지 (스냅샷) — 학습지·교재 공용.
//
// 이미지를 정답 행에 같이 두면 목록/집계 조회가 통째로 무거워지므로 분리 저장한다.
// storage='db'  : data 컬럼에 base64 (소규모 운영용 기본값)
// storage='object': objectKey만 저장하고 실제 파일은 오브젝트 스토리지(Supabase Storage).
//                   DB 용량이 커지는 것을 막는 확장 경로. ANSWER_IMAGE_STORAGE 환경변수로 전환.
model AnswerImage {
  id          String     @id @default(cuid())
  worksheetId String?
  worksheet   Worksheet? @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  textbookId  String?
  textbook    Textbook?  @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  problemNo   Int // 1-based 문제 번호
  mimeType    String     @default("image/webp")
  storage     String     @default("db") // 'db' | 'object'
  data        String? // storage='db'일 때 base64 본문
  objectKey   String? // storage='object'일 때 버킷 내 경로
  bytes       Int        @default(0) // 원본 바이트 수 (용량 집계용)
  updatedAt   DateTime   @updatedAt

  @@unique([worksheetId, problemNo])
  @@unique([textbookId, problemNo])
  @@index([worksheetId])
  @@index([textbookId])
}

model WorksheetDistribution {
  id            String             @id @default(cuid())
  worksheetId   String
  worksheet     Worksheet          @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status        DistributionStatus @default(distributed)
  distributedAt DateTime           @default(now())
  hiddenAt      DateTime? // 선생님 배포목록에서만 숨김. 학생앱·학습이력·집계에는 영향 없음

  // 숙제로 지정한 시각. null이면 수업 중 푸는 일반 배포다.
  // 배포한 뒤 학생별 학습지 목록에서 체크해 지정한다.
  // 채점을 마치면 숙제 목록에서는 빠지지만 이 값은 기록으로 남긴다.
  homeworkAt    DateTime?

  result WorksheetResult?

  @@unique([worksheetId, studentId])
  @@index([studentId])
  @@index([worksheetId])
  @@index([hiddenAt])
}

model WorksheetResult {
  id                String                @id @default(cuid())
  distributionId    String                @unique
  distribution      WorksheetDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  correctProblems   Int
  wrongProblemsJson String                @default("[]") // JSON: 틀린 문제 번호 배열 [2, 5, 8]
  gradedBy          String                @default("student") // "student" | "teacher"
  submittedAt       DateTime              @default(now())

  // 학생이 OMR·수식 키패드로 낸 답 (JSON 문자열 배열, 1번부터 순서대로)
  studentAnswersJson  String @default("[]")
  // 자동 채점이 판정하지 못한 문제 번호. 선생님이 최종 판단한다 (이미지 정답 등)
  pendingProblemsJson String @default("[]")
  // 학생이 지금까지 답을 낸 문항 수. 부분 제출이 가능해 전체 문항 수와 다를 수 있다.
  // 정답률은 이 값을 분모로 쓴다 (푼 만큼만 평가한다)
  submittedCount      Int    @default(0)
}

enum DistributionStatus {
  distributed
  submitted
  graded
}

model MissionResult {
  id              String       @id @default(cuid())
  studentId       String
  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  missionType     MissionType
  totalProblems   Int
  correctProblems Int
  source          ResultSource
  solvedAt        DateTime
  createdAt       DateTime     @default(now())

  @@index([studentId])
}

enum Role {
  student
  teacher
}

enum MissionType {
  concept_learning
  concept_problem
  basic_problem
  advanced_problem
  top_problem
}

enum ResultSource {
  manual
  mathflat
}

// ── 보상 아이템 (선생님이 생성) ────────────────────────────────────────────────
model RewardItem {
  id          String   @id @default(cuid())
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  emoji       String   @default("🎁")
  type        String   @default("virtual") // "virtual" | "physical"
  rarity      String   @default("common") // "common" | "rare" | "epic" | "legendary"
  pointValue  Int      @default(0) // 지급시 함께 부여할 포인트
  createdAt   DateTime @default(now())

  grants StudentReward[]
  rules  RewardRule[]

  @@index([teacherId])
}

// ── 학생 보관창고 ──────────────────────────────────────────────────────────────
model StudentReward {
  id         String     @id @default(cuid())
  studentId  String
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  itemId     String
  item       RewardItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity   Int        @default(1)
  status     String     @default("owned") // "owned" | "redeemed"
  reason     String     @default("")
  grantedAt  DateTime   @default(now())
  redeemedAt DateTime?

  @@index([studentId])
  @@index([itemId])
}

// ── 포인트 내역 ────────────────────────────────────────────────────────────────
model PointTransaction {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  type      String   @default("manual") // "quest" | "exam" | "manual" | "redeem"
  createdAt DateTime @default(now())

  @@index([studentId])
}

// ── 자동 보상 ────────────────────────────────────────────────────────────────
// 학습지·교재 채점이 들어오면 정답률에 따라 자동으로 포인트/아이템을 준다.
// 여러 규칙이 걸리면 기준 정답률이 가장 높은 것 하나만 적용한다(등급제).

model RewardRule {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  enabled   Boolean     @default(true)
  source    String      @default("any") // "worksheet" | "textbook" | "any"
  minRate   Int         @default(80) // 이 정답률(%) 이상일 때 지급
  points    Int         @default(0) // 지급 포인트
  itemId    String? // 함께 줄 아이템 (없으면 포인트만)
  item      RewardItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  label     String      @default("") // 지급 사유에 쓸 이름 (예: 만점 보상)
  createdAt DateTime    @default(now())

  @@index([teacherId])
  @@index([itemId])
}

// 이미 자동 보상을 준 채점 건. 재채점해도 두 번 주지 않기 위한 기록이다.
model AutoRewardLog {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sourceType String // "worksheet" | "textbook"
  sourceId   String // 배포 id 또는 교재 id
  ruleId     String
  points     Int      @default(0)
  itemId     String?
  createdAt  DateTime @default(now())

  @@unique([sourceType, sourceId, studentId])
  @@index([studentId])
}

// ── 수학 지식 그래프 (Knowledge Graph DAG) ───────────────────────────────────

enum SchoolLevel {
  ELEMENTARY // 초등
  MIDDLE     // 중등
  HIGH       // 고등
}

model ConceptNode {
  id          String      @id @default(cuid())
  code        String      @unique // 예: "MATH-H1-FUNC-012"
  title       String      // 예: "이차함수의 최대와 최소"
  domain      String      // 수와 연산, 변화와 관계(대수), 도형/기하, 확률과 통계
  gradeLevel  SchoolLevel
  semester    Int         // 1학기 / 2학기
  description String?     @db.Text
  createdAt   DateTime    @default(now())

  // DAG 선수/후수 관계 정의
  prerequisites ConceptDependency[] @relation("SuccessorToPrerequisite")
  successors    ConceptDependency[] @relation("PrerequisiteToSuccessor")

  // ── 2022 개정 교육과정 유형 분류 (신규 추가) ──────────────────────────────────
  subject              String   @default("수학")     // 수학 / 공통수학1 / 대수 / 미적분Ⅰ ...
  curriculum           String   @default("2022개정")
  status               String   @default("적용")     // "적용" | "적용예정"(중3, 2027학년도~)

  majorUnit            String   @default("")  // 대단원
  middleUnit           String   @default("")  // 중단원
  typeName             String   @default("")  // 유형 (소유형은 title 에 들어간다)

  // 같은 학기·과목 안에서의 상대 난이도. 1=하, 2=중, 3=상
  difficulty           Int      @default(2)
  // 전 과정 학습 순번 (1~1474). 스테이지 순서의 기준
  sequence             Int      @default(0)
  // 0~100. 학년 진행도 75% + 학년 내 난이도 25%. 난이도 곡선 정렬 키
  curveScore           Float    @default(0)
  // 난이도·학년 가중으로 계산한 제안 경험치
  suggestedXp          Int      @default(0)
  // 교육과정 성취기준 코드 JSON 배열. 예: ["9수02-08","9수02-09"]
  achievementStandards String   @default("[]")

  // 이 개념에 걸린 문항들 (문제은행 · 교재)
  questions        Question[]
  textbookProblems TextbookProblem[]
  // 복합 유형이 이 개념을 함께 쓰는 경우
  questionConcepts QuestionConcept[]

  @@index([domain, gradeLevel])
  @@index([sequence])
  @@index([difficulty, curveScore])
  @@index([gradeLevel, semester, majorUnit])
}

model ConceptDependency {
  id             String      @id @default(cuid())
  prerequisiteId String      // 선수 개념 ID (원인 노드)
  successorId    String      // 후수 개념 ID (결과 노드)
  weight         Float       @default(1.0) // 의존 결합도 (0.0 ~ 1.0)
  dependencyType String      @default("STRICT") // STRICT(필수), SUPPLEMENTARY(보조)

  prerequisite ConceptNode @relation("SuccessorToPrerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)
  successor    ConceptNode @relation("PrerequisiteToSuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([prerequisiteId, successorId])
  @@index([prerequisiteId])
  @@index([successorId])
}

// ── 초3~고3 K-수학 4계층 체계화 (대단원 ➡️ 중단원 ➡️ 소단원 ➡️ 문제유형) ───────────

// 1. 교육과정 학년 및 고등 선택과목
enum MathGradeSubject {
  ELEM_3_1
  ELEM_3_2
  ELEM_4_1
  ELEM_4_2
  ELEM_5_1
  ELEM_5_2
  ELEM_6_1
  ELEM_6_2
  MID_1_1
  MID_1_2
  MID_2_1
  MID_2_2
  MID_3_1
  MID_3_2
  HIGH_COMMON_1
  HIGH_COMMON_2
  HIGH_ALGEBRA
  HIGH_CALC_1
  HIGH_CALC_2
  HIGH_PROB_STAT
  HIGH_GEOMETRY
}

// 2. 대단원 (Major Unit)
model MathMajorUnit {
  id          String           @id @default(cuid())
  subject     MathGradeSubject
  orderIndex  Int
  code        String           @unique // 예: "H1_C1_MAJOR_01"
  name        String           // 예: "Ⅰ. 다항식"
  middleUnits MathMiddleUnit[]

  @@index([subject, orderIndex])
}

// 3. 중단원 (Middle Unit)
model MathMiddleUnit {
  id          String        @id @default(cuid())
  majorUnitId String
  majorUnit   MathMajorUnit @relation(fields: [majorUnitId], references: [id], onDelete: Cascade)
  orderIndex  Int
  code        String        @unique
  name        String        // 예: "1. 다항식의 연산"
  subUnits    MathSubUnit[]

  @@index([majorUnitId, orderIndex])
}

// 4. 소단원 (Sub Unit - 현재 기본 단위)
model MathSubUnit {
  id               String               @id @default(cuid())
  middleUnitId     String
  middleUnit       MathMiddleUnit       @relation(fields: [middleUnitId], references: [id], onDelete: Cascade)
  orderIndex       Int
  code             String               @unique
  name             String               // 예: "(1) 다항식의 덧셈과 뺄셈"
  patternTypes     MathPatternType[]    // 향후 점진적 확장
  questions        Question[]
  textbookProblems TextbookProblem[]
  stats            StudentSubUnitStat[]
  prescriptiveMissions PrescriptiveMission[]

  @@index([middleUnitId])
}

// 5. 문제 유형 (Pattern Type - 향후 점진적 축적)
model MathPatternType {
  id               String               @id @default(cuid())
  subUnitId        String
  subUnit          MathSubUnit          @relation(fields: [subUnitId], references: [id], onDelete: Cascade)
  typeCode         String               @unique // 예: "TYP_H1_01_01_03"
  typeName         String               // 예: "[유형03] 식의 값 구하기 - 곱셈공식 변형"
  difficulty       Int                  @default(3)
  questions        Question[]
  textbookProblems TextbookProblem[]
  stats            StudentPatternStat[]

  @@index([subUnitId])
}

// 6. 문항 모델 (소단원 / 문제유형 연결 - 점진적 확장)
// 문항 마스터 — 교재·학습지에서 독립한 문제은행의 한 문제.
//
// 교재 문제(TextbookProblem)와 같은 교육과정 좌표를 쓴다. 교재에 실린 문제를
// 문제은행으로 올릴 때 좌표를 그대로 옮길 수 있어야 하기 때문이다.
model Question {
  id            String           @id @default(cuid())

  // 교육과정 좌표 — TextbookProblem 과 같은 세 축
  subUnitId     String?
  subUnit       MathSubUnit?     @relation(fields: [subUnitId], references: [id], onDelete: SetNull)
  patternTypeId String?
  patternType   MathPatternType? @relation(fields: [patternTypeId], references: [id], onDelete: SetNull)
  conceptNodeId String?
  conceptNode   ConceptNode?     @relation(fields: [conceptNodeId], references: [id], onDelete: SetNull)

  // ── 문항 내용 ─────────────────────────────────────────────────────────────
  title         String           @default("")
  content       String?          @db.Text // 문제 본문
  answer        String           @default("")
  solution      String?          @db.Text // 풀이·해설. 반입 앱이 해설 PDF에서 뽑아 온다
  answerType    String           @default("short") // "multiple" | "short" | "image"

  // 공식 난이도 1~5. null = 아직 안 매김 ('중'과 구분해야 한다)
  difficulty    Int?

  // ── 출처 ──────────────────────────────────────────────────────────────────
  // 'textbook' | 'worksheet' | 'manual' | 'external'(반입 앱)
  sourceType    String           @default("manual")
  // 원본 식별자. 반입 앱이 준 고유 키이자 같은 문제를 두 번 넣지 못하게 하는 열쇠
  sourceRef     String?
  sourceBook    String? // 문제집 이름
  sourcePage    Int?
  sourceNumber  Int?

  // ── 원본 표기 ─────────────────────────────────────────────────────────────
  // 문제집에 적힌 말 그대로. 교육과정 좌표 매칭에 실패했을 때 되짚는 유일한 단서라
  // 매칭이 되든 안 되든 반드시 남긴다.
  rawMajorUnit  String           @default("")
  rawMiddleUnit String           @default("")
  rawMinorUnit  String           @default("")
  rawTypeName   String           @default("") // 문제집 유형명
  rawSection    String           @default("") // 문제집 구획 — 난이도 추론의 근거

  // ── 변형 관계 ─────────────────────────────────────────────────────────────
  // 문제 하나에서 뻗어 나가는 세 갈래. 원본은 ORIGINAL 이고 origin 이 없다.
  //   NUMERIC   숫자 바꾼 문제 — 같은 문제, 수치만 다르다
  //   REPHRASED 표현 바꾼 문제 — 같은 개념·공식을 다른 말로 묻는다
  //   COMPOSITE 복합 유형 — 원본 개념에 다른 단원 개념을 얹었다
  variantKind   String           @default("ORIGINAL")
  originId      String?
  origin        Question?        @relation("QuestionVariants", fields: [originId], references: [id], onDelete: SetNull)
  variants      Question[]       @relation("QuestionVariants")

  // 복합 유형이 끌어다 쓴 다른 단원 개념들.
  // 주 개념은 conceptNodeId 하나지만, 복합 유형은 여러 개념에 동시에 걸린다.
  // "개념 A와 B가 함께 나오는 문제"를 뽑으려면 다대다여야 한다.
  concepts      QuestionConcept[]

  // ── 분류 상태 ─────────────────────────────────────────────────────────────
  // 좌표가 붙은 시점과 누가 붙였는지. 'auto' | 선생님 이름.
  // 자동 매칭이 틀렸을 때 사람이 고친 것과 구분해야 재매칭 시 덮어쓰지 않는다.
  classifiedAt  DateTime?
  classifiedBy  String?

  // ── 사람이 고친 흔적 ──────────────────────────────────────────────────────
  // 선생님이 본문·답·풀이를 고쳤으면 재반입이 그것을 되돌리지 않는다.
  // 분류(classifiedBy)와 따로 두는 이유: 좌표만 고친 경우와 내용을 고친 경우가 다르다.
  editedAt      DateTime?
  editedBy      String?

  // 'active' | 'flagged'(오류 의심) | 'retired'(더 쓰지 않음).
  // 오류 문제를 지우지 않고 표시만 하는 이유 — 이미 학생에게 나간 기록이 남아 있다.
  status        String           @default("active")
  flagReason    String?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([sourceType, sourceRef])
  @@index([subUnitId, difficulty])
  @@index([patternTypeId, difficulty])
  @@index([conceptNodeId])
  // 아직 좌표가 안 붙은 문제를 모아 보는 화면용
  @@index([classifiedAt])
  @@index([sourceBook, sourcePage, sourceNumber])
  // 원본에서 파생된 변형을 모아 보기
  @@index([originId, variantKind])
  // 오류로 표시된 문제 모아 보기 / 출제 시 retired 제외
  @@index([status])
  /// 이 문항이 들어간 생성 학습지
  genItems      WorksheetGenItem[]
}

/// 문항 ↔ 개념 (다대다) — 복합 유형이 여러 단원 개념에 걸리는 것을 담는다.
/// 주 개념은 Question.conceptNodeId 에도 그대로 두어, 단일 개념만 필요한
/// 기존 조회가 이 표를 거치지 않아도 되게 한다.
model QuestionConcept {
  questionId    String
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  conceptNodeId String
  conceptNode   ConceptNode @relation(fields: [conceptNodeId], references: [id], onDelete: Cascade)
  /// 'primary'(원본 개념) | 'secondary'(융합된 다른 단원 개념)
  role          String      @default("secondary")

  @@id([questionId, conceptNodeId])
  @@index([conceptNodeId, role])
}

// 7. 학생 소단원별 정답률 누적 통계
model StudentSubUnitStat {
  id           String      @id @default(cuid())
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subUnitId    String
  subUnit      MathSubUnit @relation(fields: [subUnitId], references: [id], onDelete: Cascade)
  totalSolved  Int         @default(0)
  correctCount Int         @default(0)
  accuracyRate Float       @default(0.0) // 0.0 ~ 100.0%
  updatedAt    DateTime    @updatedAt

  @@unique([studentId, subUnitId])
  @@index([studentId, accuracyRate])
}

// 8. 학생 문제유형별 정답률 누적 통계
model StudentPatternStat {
  id            String          @id @default(cuid())
  studentId     String
  student       Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  patternTypeId String
  patternType   MathPatternType @relation(fields: [patternTypeId], references: [id], onDelete: Cascade)
  totalSolved   Int             @default(0)
  correctCount  Int             @default(0)
  accuracyRate  Float           @default(0.0) // 0.0 ~ 100.0%
  updatedAt     DateTime        @updatedAt

  @@unique([studentId, patternTypeId])
  @@index([studentId, accuracyRate])
}

// ── 학부모 맞춤 발송 시스템 (알림톡 / SMS / LMS) ──────────────────────────────────
enum AttendanceStatus {
  PRESENT
  ON_TIME
  LATE
  ABSENT
  EXCUSED
  MAKEUP
}

enum ConcentrationGrade {
  EXCELLENT
  GOOD
  NORMAL
  NEEDS_CARE
}

enum SendChannel {
  ALIMTALK
  SMS
  LMS
}

enum SendStatus {
  SUCCESS
  FAILED
  PENDING
}

// ── 하원 연동 학습리포트 발송 설정 ──────────────────────────────────────────
//
// 하원 시 학부모에게 보낼 항목을 정하는 두 계층.
//   1) DailyStudentReportOverride — 그날 그 학생만, 선생님이 직접 만진 것 (우선)
//   2) AttendanceNotificationConfig — 평상시 학원 기본값
//   3) 둘 다 없으면 코드 상수 (lib/reportOptions.ts)
// 3단계를 두는 이유: 설정을 한 번도 저장하지 않아도 발송이 멈추면 안 된다.
//
// 항목 이름은 AlimtalkSendPanel 의 checkedOptions 키와 같게 맞춘다.

/** 학원 기본 프리셋 — 학생·학습지처럼 학원 대표 계정 하나에 둔다 */
model AttendanceNotificationConfig {
  id        String  @id @default(cuid())
  teacherId String  @unique
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  includeAttendance   Boolean @default(true)  // 지각 유무
  includeHomework     Boolean @default(true)  // 숙제 완성도·점수
  includeCalcBook     Boolean @default(true)  // 연산교재
  includeProgressBook Boolean @default(true)  // 진도교재 채점
  includeWorksheet    Boolean @default(true)  // 오답 클리닉 학습지
  includeUnitExam     Boolean @default(true)  // 단원평가·모의고사
  includeGoalRate     Boolean @default(false) // 일일 목표 완성률
  includeAttitude     Boolean @default(false) // 수업 태도
  includeComment      Boolean @default(false) // 선생님 코멘트

  // 하원 처리 시 학습리포트를 자동 발송할지. 기본은 꺼짐 —
  // 선생님이 켜기 전에는 학부모에게 아무것도 나가지 않는다
  autoSendOnCheckOut Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** 당일 오버라이드 — 그날 하루만 유효하다. 없으면 위 프리셋을 쓴다 */
model DailyStudentReportOverride {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // AttendanceLog 와 같은 "YYYY-MM-DD" 문자열. 시각이 아니라 날짜로 잘라야
  // 하원 뒤에 채점한 건도 같은 날로 묶인다
  date      String

  includeAttendance   Boolean @default(true)
  includeHomework     Boolean @default(true)
  includeCalcBook     Boolean @default(true)
  includeProgressBook Boolean @default(true)
  includeWorksheet    Boolean @default(true)
  includeUnitExam     Boolean @default(true)
  includeGoalRate     Boolean @default(false)
  includeAttitude     Boolean @default(false)
  includeComment      Boolean @default(false)

  /** 수업 태도 — 데이터로 뽑을 수 없어 선생님이 그날 직접 적는다 */
  attitude  String?
  /** 선생님 코멘트 (자유 문장) */
  comment   String?

  /** 누가 고쳤는지 — 나중에 "왜 이 항목이 갔지"를 따라갈 수 있어야 한다 */
  editedBy  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
  @@index([date])
}

model DailyLessonReport {
  id                   String             @id @default(cuid())
  studentId            String
  student              Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentName          String
  parentPhone          String
  reportDate           DateTime           @default(now())

  // 자동 집계 데이터 (%)
  homeworkCompletion   Float              @default(0.0)
  calcBookCompletion   Float              @default(0.0)
  progressBookScore    Float              @default(0.0)
  worksheetScore       Float              @default(0.0)
  unitExamScore        Float?
  targetGoalRate       Float              @default(0.0)
  studyTimeAchieveRate Float              @default(0.0)

  // 교사 입력 데이터
  attendance           AttendanceStatus   @default(ON_TIME)
  lateMinutes          Int                @default(0)
  concentrationGrade   ConcentrationGrade @default(NORMAL)
  teacherComment       String?            @db.Text

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  sendLogs             AlimtalkSendLog[]

  @@index([studentId, reportDate])
}

model AlimtalkSendLog {
  id              String             @id @default(cuid())
  reportId        String?
  report          DailyLessonReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  studentName     String             @default("")
  parentPhone     String             @default("")
  receiverPhone   String             @default("")
  sendChannel     SendChannel        // ALIMTALK | SMS | LMS
  messageType     String             @default("AT") // AT, SMS, LMS
  templateCode    String?
  messageTitle    String?
  sentMessageText String?            @db.Text
  messageBody     String             @default("") @db.Text
  includedOptions Json?
  status          SendStatus         @default(PENDING)
  statusCode      String?            // SUCCESS | FAIL
  responseCode    String?
  responseMessage String?
  bizmsgMsgId     String?
  resendChannel   SendChannel?       // 실패 시 대체 발송 채널
  sentAt          DateTime           @default(now())

  @@index([parentPhone])
  @@index([receiverPhone])
  @@index([sendChannel, status])
  @@index([sentAt])
}

// ── 학생별 맞춤 취약 정답률(%) 기준 설정 & 자동 처방 미션 ────────────────────────
enum LearningTrackType {
  BASIC
  STANDARD
  ADVANCED
}

model StudentWeaknessConfig {
  id               String            @id @default(cuid())
  studentId        String            @unique
  student          Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  customThreshold  Float             @default(60.0) // 취약 기준 정답률 (30% ~ 85%)
  trackType        LearningTrackType @default(STANDARD) // BASIC | STANDARD | ADVANCED
  autoPrescription Boolean           @default(true) // 미달 시 AI 자동 처방 미션 발급 여부
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([studentId])
}

model PrescriptiveMission {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subUnitId      String
  subUnit        MathSubUnit  @relation(fields: [subUnitId], references: [id], onDelete: Cascade)
  missionType    String       @default("AI_AUTO_CLINIC")
  title          String
  targetAccuracy Float        @default(80.0)
  voiceMessage   String?      @db.Text
  isCompleted    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([studentId, isCompleted])
  @@index([subUnitId])
}

enum StudentStatus {
  ENROLLED  // 재원
  DISCHARGED // 퇴원
  ON_LEAVE  // 휴원
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
  ABSENT
  MAKEUP
}

model AttendanceLog {
  id           String           @id @default(cuid())
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type         AttendanceType   @default(CHECK_IN) // CHECK_IN | CHECK_OUT | ABSENT | MAKEUP
  status       AttendanceStatus @default(PRESENT)  // PRESENT | ON_TIME | LATE | ABSENT | EXCUSED | MAKEUP
  date         String           // "YYYY-MM-DD"
  checkInTime  DateTime?        // 등원 시각
  checkOutTime DateTime?        // 하원 시각

  // 지각한 정도. status가 LATE일 때만 의미가 있다.
  // 10·20·30·40·50 중 하나이고, 60은 "60분 이상"을 뜻한다.
  // 정규 수업 시작 시각을 학생별로 확정할 수 없어(ClassSchedule이 학생을 이름
  // 문자열로 들고 있다) 자동 계산 대신 선생님이 고른 값을 그대로 담는다.
  lateMinutes  Int?
  alimtalkSent Boolean          @default(false)
  smsSent      Boolean          @default(false)
  memo         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([studentId, date])
  @@index([date])
}

model AlimtalkLog {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  templateCode   String   // INLEV_ATTEND_IN, INLEV_ATTEND_OUT, INLEV_REPORT
  recipientPhone String
  content        String   @db.Text
  sentStatus     String   // SUCCESS | FAILED
  providerMsgId  String?
  sentAt         DateTime @default(now())

  @@index([studentId])
  @@index([sentAt])
}
