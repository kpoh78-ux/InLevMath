// packages/database/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. 교육과정 학년 및 고등 선택과목
enum MathGradeSubject {
  ELEM_3_1
  ELEM_3_2
  ELEM_4_1
  ELEM_4_2
  ELEM_5_1
  ELEM_5_2
  ELEM_6_1
  ELEM_6_2
  MID_1_1
  MID_1_2
  MID_2_1
  MID_2_2
  MID_3_1
  MID_3_2
  HIGH_COMMON_1
  HIGH_COMMON_2
  HIGH_ALGEBRA
  HIGH_CALC_1
  HIGH_CALC_2
  HIGH_PROB_STAT
  HIGH_GEOMETRY
}

// 2. 대단원 (Major Unit)
model MathMajorUnit {
  id          String           @id @default(cuid())
  subject     MathGradeSubject
  orderIndex  Int
  code        String           @unique // 예: "H1_C1_MAJOR_01"
  name        String           // 예: "Ⅰ. 다항식"
  middleUnits MathMiddleUnit[]

  @@index([subject, orderIndex])
}

// 3. 중단원 (Middle Unit)
model MathMiddleUnit {
  id          String        @id @default(cuid())
  majorUnitId String
  majorUnit   MathMajorUnit @relation(fields: [majorUnitId], references: [id], onDelete: Cascade)
  orderIndex  Int
  code        String        @unique
  name        String        // 예: "1. 다항식의 연산"
  subUnits    MathSubUnit[]

  @@index([majorUnitId, orderIndex])
}

// 4. 소단원 (Sub Unit - 현재 기본 단위)
model MathSubUnit {
  id           String               @id @default(cuid())
  middleUnitId String
  middleUnit   MathMiddleUnit       @relation(fields: [middleUnitId], references: [id], onDelete: Cascade)
  orderIndex   Int
  code         String               @unique
  name         String               // 예: "(1) 다항식의 덧셈과 뺄셈"
  patternTypes MathPatternType[]    // 향후 점진적 확장
  questions    Question[]
  stats        StudentSubUnitStat[]

  @@index([middleUnitId])
}

// 5. 문제 유형 (Pattern Type - 향후 점진적 축적)
model MathPatternType {
  id         String               @id @default(cuid())
  subUnitId  String
  subUnit    MathSubUnit          @relation(fields: [subUnitId], references: [id], onDelete: Cascade)
  typeCode   String               @unique // 예: "TYP_H1_01_01_03"
  typeName   String               // 예: "[유형03] 식의 값 구하기 - 곱셈공식 변형"
  difficulty Int                  @default(3)
  questions  Question[]
  stats      StudentPatternStat[]

  @@index([subUnitId])
}

// 6. 문항 모델 (소단원 / 문제유형 연결 - 점진적 확장)
model Question {
  id            String           @id @default(cuid())
  subUnitId     String?
  subUnit       MathSubUnit?     @relation(fields: [subUnitId], references: [id], onDelete: SetNull)
  patternTypeId String?
  patternType   MathPatternType? @relation(fields: [patternTypeId], references: [id], onDelete: SetNull)
  title         String           @default("")
  content       String?          @db.Text
  answer        String           @default("")
  solution      String?          @db.Text
  difficulty    Int              @default(3)
  sourceType    String           @default("custom") // custom, textbook, exam
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([subUnitId])
  @@index([patternTypeId])
}

// 7. 학생 소단원별 누적 학습 통계
model StudentSubUnitStat {
  id             String      @id @default(cuid())
  studentId      String
  subUnitId      String
  subUnit        MathSubUnit @relation(fields: [subUnitId], references: [id], onDelete: Cascade)
  totalSolved    Int         @default(0)
  totalCorrect   Int         @default(0)
  accuracyRate   Float       @default(0.0)
  masteryScore   Float       @default(0.0)
  lastStudiedAt  DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([studentId, subUnitId])
  @@index([studentId])
  @@index([subUnitId])
}

// 8. 학생 문제유형별 누적 학습 통계 (향후 유형별 정밀 분석)
model StudentPatternStat {
  id            String          @id @default(cuid())
  studentId     String
  patternTypeId String
  patternType   MathPatternType @relation(fields: [patternTypeId], references: [id], onDelete: Cascade)
  totalSolved   Int             @default(0)
  totalCorrect  Int             @default(0)
  accuracyRate  Float           @default(0.0)
  lastStudiedAt DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([studentId, patternTypeId])
  @@index([studentId])
  @@index([patternTypeId])
}

// 9. 교재 1쪽당 5문항 고정 단원 매핑 템플릿
model TextbookPageTemplate {
  id          String           @id @default(cuid())
  subject     MathGradeSubject
  pageNumber  Int
  title       String?
  stageIndex  Int?
  subUnitId   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([subject, pageNumber])
  @@index([subject])
}

// 10. 학습 진행 트랙 (진도/복습/심화/클리닉)
enum LearningTrackType {
  BASIC
  STANDARD
  ADVANCED
}

enum AttendanceStatus {
  PRESENT   // 출석/등원
  ON_TIME   // 정시 출석
  LATE      // 지각
  ABSENT    // 결석
  EXCUSED   // 조퇴/공결
  MAKEUP    // 보강
}

enum StudentStatus {
  ENROLLED  // 재원
  DISCHARGED // 퇴원
  ON_LEAVE  // 휴원
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
  ABSENT
  MAKEUP
}

model Student {
  id              String         @id @default(uuid())
  name            String
  gradeLevel      String?        // '초' | '중' | '고'
  grade           String         // '5학년'
  attendancePin   String?        @db.VarChar(4) // 4자리 등하원 출결 번호 (기본: 전화번호 끝자리, 형제자매 시 커스텀)
  status          StudentStatus  @default(ENROLLED)
  studentAppId    String?        @unique // S29757874
  parentAppId     String?        @unique // P51560034
  studentPhone    String?        // 01054013630
  parentPhone     String?        // 01050016601
  schoolName      String?        // 수완초
  classStartDate  DateTime?
  birthDate       DateTime?
  email           String?

  attendanceLogs  AttendanceLog[]
  alimtalkLogs    AlimtalkLog[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([attendancePin])
  @@index([status])
}

model AttendanceLog {
  id           String           @id @default(uuid())
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type         AttendanceType   @default(CHECK_IN)
  status       AttendanceStatus @default(PRESENT)
  date         DateTime         @default(now()) @db.Date
  checkInTime  DateTime?
  checkOutTime DateTime?
  memo         String?
  smsSent      Boolean          @default(false)
  alimtalkSent Boolean          @default(false)

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([studentId, date])
  @@index([date])
}

model AlimtalkLog {
  id             String   @id @default(uuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  templateCode   String   // INLEV_ATTEND_IN, INLEV_ATTEND_OUT, INLEV_REPORT
  recipientPhone String
  content        String   @db.Text
  sentStatus     String   // SUCCESS | FAILED
  providerMsgId  String?
  sentAt         DateTime @default(now())

  @@index([studentId])
  @@index([sentAt])
}
